# ============================================================
# Kopjoni këtë skedar si .env te rrënja e projektit
# cp deploy/.env.example .env
# ============================================================

# Database (ndrysho fjalekalimin!)
DATABASE_URL=postgresql://USER:REPLACE_ME@localhost:5432/fmsdb

# Siguri sesion (gjenero një string të gjatë random)
SESSION_SECRET=vendos_ketu_nje_fjalekalim_shume_te_gjate_dhe_random_123456

# RapidAPI për Google Flights
RAPIDAPI_KEY=vendos_ketu_rapidapi_key

# Email për njoftime çmimesh
NOTIFY_EMAIL=ernestkasajtp@gmail.com

# SMTP — konfigurimi per dergimin e emaileve
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=fjalekalimi_smtp

# Emri i derguesit (opsionale, default: SMTP_USER)
GMAIL_FROM="FMS Pro <noreply@yourdomain.com>"

# Mjedisi
NODE_ENV=production
